# GitHub App (Settings > Developer settings > GitHub Apps)
APP_ID=
PRIVATE_KEY_PATH=./gitroast.private-key.pem
WEBHOOK_SECRET=

# Pickers, tried in order. Unconfigured ones are skipped; rules always runs last.
PICKERS=jev,von,rules

# Jev (hosted by TypeSafe AI). Leave empty to disable.
TYPESAFE_API_KEY=

# Von (local, open-weights). Leave VON_BASE_URL empty to disable.
VON_BASE_URL=
VON_MODEL=von-latest
VON_TIMEOUT_MS=5000

# Time zone for the Friday-evening and late-night signals.
TIMEZONE=Europe/Zurich

PORT=3000
LOG_LEVEL=info
